{
  "name": "game-hub",
  "version": "1.0.0",
  "description": "小游戏与日本麻将合集：日麻、2048、贪吃蛇、俄罗斯方块等",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/tiny-playworks/game-hub.git"
  },
  "homepage": "https://game-hub-sage-nine.vercel.app",
  "keywords": [
    "games",
    "mahjong",
    "react",
    "rsbuild",
    "mini-games"
  ],
  "scripts": {
    "build": "rsbuild build",
    "build:analyze": "RSDOCTOR=true rsbuild build",
    "check": "pnpm run typecheck && biome check --write",
    "dev": "rsbuild dev --open",
    "format": "biome format --write",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:coverage": "rstest --coverage",
    "test:watch": "rstest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "riichi-rs-bundlers": "^2.1.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@rsbuild/core": "^2.2.10",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsdoctor/rspack-plugin": "^1.6.4",
    "@rstest/adapter-rsbuild": "^0.12.2",
    "@rstest/core": "^0.12.2",
    "@rstest/coverage-istanbul": "0.12.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
