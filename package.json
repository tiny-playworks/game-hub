{
  "name": "game-hub",
  "version": "1.0.0",
  "description": "小游戏与日本麻将合集：日麻、2048、贪吃蛇、俄罗斯方块等",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/tiny-playworks/game-hub.git"
  },
  "homepage": "https://game-hub-sage-nine.vercel.app",
  "keywords": [
    "games",
    "mahjong",
    "react",
    "rsbuild",
    "mini-games"
  ],
  "scripts": {
    "build": "rsbuild build",
    "build:analyze": "RSDOCTOR=true rsbuild build",
    "check": "pnpm run typecheck && biome check --write",
    "dev": "rsbuild dev --open",
    "format": "biome format --write",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "riichi-rs-bundlers": "^2.1.0",
    "tailwind-merge": "^3.6.0",
    "use-sound": "^5.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@rsbuild/core": "^2.0.7",
    "@rsbuild/plugin-react": "^2.0.0",
    "@rsdoctor/rspack-plugin": "^1.5.11",
    "@rstest/adapter-rsbuild": "^0.10.2",
    "@rstest/core": "^0.10.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
