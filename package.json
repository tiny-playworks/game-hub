{
  "name": "game-hub",
  "version": "1.0.0",
  "description": "小游戏与日本麻将合集：日麻、2048、贪吃蛇、俄罗斯方块等",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tiny-playworks/game-hub.git"
  },
  "homepage": "https://game-hub-sage-nine.vercel.app",
  "keywords": [
    "games",
    "mahjong",
    "react",
    "rsbuild",
    "rstack",
    "mini-games"
  ],
  "scripts": {
    "build": "rs build",
    "build:analyze": "RSDOCTOR=true rs build",
    "check": "rs check --type-check --fix",
    "deploy:nas": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-to-nas.ps1",
    "dev": "rs dev --open",
    "format": "rs fmt",
    "lint": "rs lint",
    "preview": "rs preview",
    "prepare:nas": "node scripts/prepare-nas-release.mjs",
    "test": "rs test",
    "test:coverage": "rs test --coverage",
    "test:watch": "rs test --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "riichi-rs-bundlers": "^2.1.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "use-sync-external-store": "1.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "@rstest/coverage-istanbul": "^0.12.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.5",
    "rstack": "^0.8.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
